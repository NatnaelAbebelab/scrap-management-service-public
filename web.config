<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <add key="WSGI_HANDLER" value="django.core.wsgi.get_wsgi_application()" />
    <add key="PYTHONPATH" value="C:\inetpub\wwwroot\scrap-management-service" />
    <add key="DJANGO_SETTINGS_MODULE" value="winscale.settings" />
<add key="WSGI_LOG" value="C:\Users\IT-D\AppData\Local\Programs\Python\Python312\Lib\site-packages\error.log" />
  </appSettings>

  <system.webServer>
    <handlers>
      <remove name="scrap" />
      <add name="scrap" path="*" verb="*" modules="FastCgiModule" scriptProcessor="C:\Users\IT-D\AppData\Local\Programs\Python\Python312\python.exe|C:\Users\IT-D\AppData\Local\Programs\Python\Python312\Lib\site-packages\wfastcgi.py" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
        <defaultDocument>
            <files>
                <clear />
                <add value="index.html" />
                <add value="Default.htm" />
                <add value="Default.asp" />
                <add value="index.htm" />
                <add value="iisstart.htm" />
            </files>
        </defaultDocument>
  </system.webServer>
</configuration>

